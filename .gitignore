# Local secrets and environment configuration
.env
.env.*
!.env.example

# Logs (never commit runtime logs: they can hold personal data)
*.log
**/storage/logs/*
!**/storage/logs/.gitignore

# Signing keys and private credentials
*.pem
*.p12
*.jks
*.keystore
key.properties
auth.json

# Dependencies and generated output
node_modules/
vendor/
.next/
dist/
build/
coverage/
.gradle/

# Local editor and operating system files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Oversized duplicate documentation archive (the extracted docs are included)
/eSchool-SaaS-Doc-main.zip
